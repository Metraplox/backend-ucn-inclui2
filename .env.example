# 🚀 UCN INCLUI2 BACKEND - CONFIGURACIÓN DE DESARROLLO
# ===========================================================
# Copia este archivo como .env y configura los valores

# 🗄️ BASE DE DATOS
DATABASE_URL=mongodb://localhost:27017/ucn_inclui2_dev
MONGODB_URI=mongodb://localhost:27017/ucn_inclui2_dev

# 🔐 AUTENTICACIÓN JWT
JWT_SECRET=tu-jwt-secret-super-seguro-aqui
JWT_REFRESH_SECRET=tu-refresh-secret-super-seguro-aqui
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 🔑 GOOGLE OAUTH (Opcional)
GOOGLE_CLIENT_ID=tu-google-client-id-aqui

# 🌊 INTEGRACIÓN HAWAII API UCN (Opcional para desarrollo)
HAWAII_BASE_URL=https://losvilos.ucn.cl/hawaii/api
HAWAII_AUTH_OFERTA=tu-auth-oferta-hawaii
HAWAII_AUTH_ESTUDIANTES=tu-auth-estudiantes-hawaii
HAWAII_AUTH_INSCRIPCION=tu-auth-inscripcion-hawaii
HAWAII_REQUEST_TIMEOUT=30000

# 🚀 SERVIDOR
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# 🎯 CONFIGURACIÓN ACADÉMICA
CURRENT_SEMESTER=2025-1

# 📁 ARCHIVOS Y UPLOADS
UPLOAD_LOCATION=./uploads
TEMPLATES_LOCATION=./templates
NEE_STUDENTS_FILE=./docs/assets/ESTUDIANTES_NEE_CSV.txt

# 🔒 SEGURIDAD
DEFAULT_USER_PASSWORD=password123
BCRYPT_SALT_ROUNDS=10

# 🌐 FRONTEND (Para CORS)
FRONTEND_URL=http://localhost:5000

# 📝 LOGGING
LOG_LEVEL=debug
APP_NAME=UCN_INCLUI2

# 📧 CONFIGURACIÓN ADICIONAL (Opcional)
# EMAIL_SERVICE=gmail
# EMAIL_USER=tu-email@ucn.cl
# EMAIL_PASSWORD=tu-password-email
HAWAII_REQUEST_TIMEOUT=30000
BCRYPT_SALT_ROUNDS=10
FRONTEND_URL=http://localhost:4200
LOG_LEVEL=debug